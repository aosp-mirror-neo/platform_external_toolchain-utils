patch.metadata.author: Alex Bradbury <asb@igalia.com>
patch.metadata.original_sha: a314b3b401b5f9e6218d863bfcc29393e1b6f447
patch.platforms: chromiumos
patch.version_range.from: 567963
patch.version_range.until: 596943

