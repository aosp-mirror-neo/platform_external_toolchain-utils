From e79ba212575a7b27f3d55a4abdcd141dcb21d135 Mon Sep 17 00:00:00 2001
From: eaeltsin <eaeltsin@google.com>
Date: Tue, 10 Nov 2026 23:48:49 +0000
Subject: [PATCH] [BPF] Wrap both cross-BB icmp conditions in BPFAdjustOpt
 (#231257)

In `BPFAdjustOptImpl::serializeICMPCrossBB`, only `B1`'s branch
condition was wrapped in `@llvm.bpf.passthrough.i1.i1`, leaving `B2`'s
branch condition unwrapped. Because `foldBranchToCommonDest` in
`SimplifyCFG` only checks that `B2`'s branch condition is a `CmpInst`,
`SimplifyCFG` still merged `B2` into `B1` using a `select`. After
3b5fbbd0b5f8 (#226297), `ConstraintElimination`'s `addInfoForInductions`
matched the unwrapped `B2` `icmp` in the merged `select` condition,
deduced a loop header bound on the induction variable, and folded `B1`'s
upper-bound `icmp` to `true` inside `@llvm.bpf.passthrough.i1.i1`,
causing the BPF verifier to reject valid loops.

Additionally, `serializeICMPCrossBB` previously started from a successor
of `B2` via `BB.getSinglePredecessor()`, causing it to match the same
`(B1, B2)` pair twice when both successors of `B2` had `B2` as their
single predecessor.

Fix `serializeICMPCrossBB` to treat `BB` as `B2` directly and wrap both
`B1`'s and `B2`'s `icmp` conditions in `@llvm.bpf.passthrough.i1.i1` so
`SimplifyCFG` and `ConstraintElimination` keep both comparisons intact.

Fixes #231175
---
 llvm/lib/Target/BPF/BPFAdjustOpt.cpp      | 46 +++++++++++-----------
 llvm/test/CodeGen/BPF/adjust-opt-icmp7.ll | 47 +++++++++++++++++++++++
 2 files changed, 69 insertions(+), 24 deletions(-)
 create mode 100644 llvm/test/CodeGen/BPF/adjust-opt-icmp7.ll

diff --git a/llvm/lib/Target/BPF/BPFAdjustOpt.cpp b/llvm/lib/Target/BPF/BPFAdjustOpt.cpp
index 78561040b4ac..6845f6504a80 100644
--- a/llvm/lib/Target/BPF/BPFAdjustOpt.cpp
+++ b/llvm/lib/Target/BPF/BPFAdjustOpt.cpp
@@ -210,41 +210,39 @@ bool BPFAdjustOptImpl::serializeICMPCrossBB(BasicBlock &BB) {
   //     if (comp1) goto B2 else B3;
   //   B2:
   //     comp2 = icmp <opcode> ...;
+  //     comp2 = __builtin_bpf_passthrough(seq_num, comp2);
   //     if (comp2) goto B4 else B5;
   //   B4:
   //     ...
 
-  // Check basic predecessors, if two of them (say B1, B2) are using
-  // icmp instructions to generate conditions and one is the predesessor
-  // of another (e.g., B1 is the predecessor of B2). Add a passthrough
-  // barrier after icmp inst of block B1.
-  BasicBlock *B2 = BB.getSinglePredecessor();
-  if (!B2)
-    return false;
-
+  // Check basic blocks, if two of them (say B1, B2) are using
+  // icmp instructions to generate conditions and one is the predecessor
+  // of another (e.g., B1 is the predecessor of B2). Add passthrough
+  // barriers after the icmp insts of blocks B1 and B2.
+  BasicBlock *B2 = &BB;
   BasicBlock *B1 = B2->getSinglePredecessor();
   if (!B1)
     return false;
 
-  Instruction *TI = B2->getTerminator();
-  auto *BI = dyn_cast<CondBrInst>(TI);
-  if (!BI)
+  Instruction *TI2 = B2->getTerminator();
+  auto *BI2 = dyn_cast<CondBrInst>(TI2);
+  if (!BI2)
     return false;
-  auto *Cond = dyn_cast<ICmpInst>(BI->getCondition());
-  if (!Cond || &*B2->getFirstNonPHIIt() != Cond)
+  auto *Cond2 = dyn_cast<ICmpInst>(BI2->getCondition());
+  if (!Cond2 || &*B2->getFirstNonPHIIt() != Cond2)
     return false;
-  Value *B2Op0 = Cond->getOperand(0);
-  auto Cond2Op = Cond->getPredicate();
+  Value *B2Op0 = Cond2->getOperand(0);
+  auto Cond2Op = Cond2->getPredicate();
 
-  TI = B1->getTerminator();
-  BI = dyn_cast<CondBrInst>(TI);
-  if (!BI)
+  Instruction *TI1 = B1->getTerminator();
+  auto *BI1 = dyn_cast<CondBrInst>(TI1);
+  if (!BI1)
     return false;
-  Cond = dyn_cast<ICmpInst>(BI->getCondition());
-  if (!Cond)
+  auto *Cond1 = dyn_cast<ICmpInst>(BI1->getCondition());
+  if (!Cond1)
     return false;
-  Value *B1Op0 = Cond->getOperand(0);
-  auto Cond1Op = Cond->getPredicate();
+  Value *B1Op0 = Cond1->getOperand(0);
+  auto Cond1Op = Cond1->getPredicate();
 
   if (B1Op0 != B2Op0)
     return false;
@@ -265,8 +263,8 @@ bool BPFAdjustOptImpl::serializeICMPCrossBB(BasicBlock &BB) {
     return false;
   }
 
-  PassThroughInfo Info(Cond, BI, 0);
-  PassThroughs.push_back(Info);
+  PassThroughs.emplace_back(Cond1, BI1, 0);
+  PassThroughs.emplace_back(Cond2, BI2, 0);
 
   return true;
 }
diff --git a/llvm/test/CodeGen/BPF/adjust-opt-icmp7.ll b/llvm/test/CodeGen/BPF/adjust-opt-icmp7.ll
new file mode 100644
index 000000000000..d761c2c585b9
--- /dev/null
+++ b/llvm/test/CodeGen/BPF/adjust-opt-icmp7.ll
@@ -0,0 +1,47 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes='pipeline-early-simplification-callbacks<O2>' -mtriple=bpf-pc-linux -S %s | FileCheck %s
+
+define i32 @foo(i32 %n) {
+; CHECK-LABEL: define i32 @foo(
+; CHECK-SAME: i32 [[N:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    br label %[[LOOP:.*]]
+; CHECK:       [[LOOP]]:
+; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[INC:%.*]], %[[LATCH:.*]] ]
+; CHECK-NEXT:    [[CMP1:%.*]] = icmp slt i32 [[I]], 16
+; CHECK-NEXT:    [[TMP0:%.*]] = call i1 @llvm.bpf.passthrough.i1.i1(i32 0, i1 [[CMP1]])
+; CHECK-NEXT:    br i1 [[TMP0]], label %[[COND2:.*]], label %[[EXIT1:.*]]
+; CHECK:       [[COND2]]:
+; CHECK-NEXT:    [[CMP2:%.*]] = icmp sge i32 [[I]], [[N]]
+; CHECK-NEXT:    [[TMP1:%.*]] = call i1 @llvm.bpf.passthrough.i1.i1(i32 1, i1 [[CMP2]])
+; CHECK-NEXT:    br i1 [[TMP1]], label %[[EXIT2:.*]], label %[[LATCH]]
+; CHECK:       [[LATCH]]:
+; CHECK-NEXT:    [[INC]] = add nsw i32 [[I]], 1
+; CHECK-NEXT:    br label %[[LOOP]]
+; CHECK:       [[EXIT1]]:
+; CHECK-NEXT:    ret i32 0
+; CHECK:       [[EXIT2]]:
+; CHECK-NEXT:    ret i32 1
+;
+entry:
+  br label %loop
+
+loop:
+  %i = phi i32 [ 0, %entry ], [ %inc, %latch ]
+  %cmp1 = icmp slt i32 %i, 16
+  br i1 %cmp1, label %cond2, label %exit1
+
+cond2:
+  %cmp2 = icmp sge i32 %i, %n
+  br i1 %cmp2, label %exit2, label %latch
+
+latch:
+  %inc = add nsw i32 %i, 1
+  br label %loop
+
+exit1:
+  ret i32 0
+
+exit2:
+  ret i32 1
+}
