-define dso_local void @test_fetch_sub_64_noret(ptr nocapture noundef %i) local_unnamed_addr #0 {
-; CHECK-LABEL: test_fetch_sub_64_noret:
-; CHECK:       .Ltest_fetch_sub_64_noret$local:
