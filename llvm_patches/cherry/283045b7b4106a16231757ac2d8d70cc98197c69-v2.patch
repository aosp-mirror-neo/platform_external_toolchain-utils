+; CHECK-LABEL: test_fetch_sub_32_noret:
+; CHECK:       .Ltest_fetch_sub_32_noret$local:
+; CHECK-NEXT:    .type .Ltest_fetch_sub_32_noret$local,@function
 ; CHECK-NEXT:  # %bb.0: # %entry
-; CHECK-NEXT:    r2 = 10
 ; CHECK-NEXT:    r2 = -r2
 ; CHECK-NEXT:    r3 = r2
