From c355352947be106cd0f530ac0a620c977425ee60 Mon Sep 17 00:00:00 2001
From: Sharjeel Khan <sharjeelkhan@google.com>
Date: Wed, 4 Nov 2026 08:46:39 -0800
Subject: [PATCH] Expand atomicrmw sub into atomicrmw add of negated value
 (#236193)

https://github.com/llvm/llvm-project/pull/184715 changed `InstCombine`
to rewrite `atomicrmw add(p, sub(0, x))` into `atomicrmw sub(p, x)`. The
64-bit `atomic_load_sub` patterns were placed outside `BPFHasALU32`,
causing `-mcpu=v1/v2` to lower subtractions to `XFADDD`
(`atomic_fetch_add`) even when the return value is unused. This causes
Linux 5.10 kernels (still supported per
https://www.kernel.org/category/releases.html and used in Android) to
reject the BPF program. Since BPF has no atomic sub instruction, we
allow atomic sub to lower to atomic add of negated value by removing the
`atomic_load_sub` patterns from `BPFInstrInfo.td`.

As a result, this PR partially reverts
https://github.com/llvm/llvm-project/pull/107343 and
https://github.com/llvm/llvm-project/pull/210371.

Assisted-by: Gemini
---
 llvm/lib/Target/BPF/BPFISelLowering.cpp       |   2 +
 llvm/lib/Target/BPF/BPFInstrInfo.td           |  20 ----
 llvm/test/CodeGen/BPF/atomics_mem_order_v1.ll | 102 +++++++++++-------
 llvm/test/CodeGen/BPF/atomics_mem_order_v3.ll |  44 ++++----
 4 files changed, 88 insertions(+), 80 deletions(-)

diff --git a/llvm/lib/Target/BPF/BPFISelLowering.cpp b/llvm/lib/Target/BPF/BPFISelLowering.cpp
index 435f0e15a25c..42b654df1f56 100644
--- a/llvm/lib/Target/BPF/BPFISelLowering.cpp
+++ b/llvm/lib/Target/BPF/BPFISelLowering.cpp
@@ -113,6 +113,8 @@ BPFTargetLowering::BPFTargetLowering(const TargetMachine &TM,
   for (auto VT : {MVT::i32, MVT::i64}) {
     setOperationAction(ISD::ATOMIC_LOAD, VT, Custom);
     setOperationAction(ISD::ATOMIC_STORE, VT, Custom);
+    // No atomic sub insn. Expand it into atomic add of the negated value.
+    setOperationAction(ISD::ATOMIC_LOAD_SUB, VT, Expand);
   }
 
   setOperationAction(ISD::ATOMIC_FENCE, MVT::Other, Custom);
diff --git a/llvm/lib/Target/BPF/BPFInstrInfo.td b/llvm/lib/Target/BPF/BPFInstrInfo.td
index c86b45ee93cc..e11dc47e99ce 100644
--- a/llvm/lib/Target/BPF/BPFInstrInfo.td
+++ b/llvm/lib/Target/BPF/BPFInstrInfo.td
@@ -1037,17 +1037,6 @@ let Predicates = [BPFHasALU32] in {
       def : Pat<(P[0] ADDRri:$addr, GPR32:$val), (P[1]  ADDRri:$addr, GPR32:$val)>;
     }
 
-    // atomic_load_sub can be represented as a neg followed
-    // by an atomic_load_add.
-    foreach P = [[atomic_load_sub_i32_monotonic,  XADDW32],
-                 [atomic_load_sub_i32_acquire,   XFADDW32],
-                 [atomic_load_sub_i32_release,   XFADDW32],
-                 [atomic_load_sub_i32_acq_rel,   XFADDW32],
-                 [atomic_load_sub_i32_seq_cst,   XFADDW32],
-                ] in {
-      def : Pat<(P[0] ADDRri:$addr, GPR32:$val), (P[1]  ADDRri:$addr, (NEG_32 GPR32:$val))>;
-    }
-
     foreach P = [// add
                  [atomic_load_add_i64_monotonic,  XADDD],
                  [atomic_load_add_i64_acquire,   XFADDD],
@@ -1059,15 +1048,6 @@ let Predicates = [BPFHasALU32] in {
     }
 }
 
-foreach P = [[atomic_load_sub_i64_monotonic,  XADDD],
-             [atomic_load_sub_i64_acquire,   XFADDD],
-             [atomic_load_sub_i64_release,   XFADDD],
-             [atomic_load_sub_i64_acq_rel,   XFADDD],
-             [atomic_load_sub_i64_seq_cst,   XFADDD],
-            ] in {
-  def : Pat<(P[0] ADDRri:$addr, GPR:$val), (P[1]  ADDRri:$addr, (NEG_64 GPR:$val))>;
-}
-
 // Borrow the idea from X86InstrFragments.td
 class binop_no_use<SDPatternOperator operator>
       : PatFrag<(ops node:$A, node:$B),
